	partition Date = calculated
		mode: import
		source =
				
				VAR MinDate = DATE ( YEAR ( MIN ( Refuels[Date] ) ), 1, 1 )
				VAR MaxDate = DATE ( YEAR ( MAX ( Refuels[Date] ) ), 12, 31 )
				RETURN
				    ADDCOLUMNS (
				        CALENDAR ( MinDate, MaxDate ),
				        "Year", YEAR ( [Date] ),
				        "Quarter", "Q" & QUARTER ( [Date] ),
				        "Month Number", MONTH ( [Date] ),
				        "Month", FORMAT ( [Date], "MMM", "en-US" ),
				        "Year-Month", FORMAT ( [Date], "YYYY-MM" ),
				        "Weekday Number", WEEKDAY ( [Date], 2 ),
				        "Weekday", FORMAT ( [Date], "ddd", "en-US" ),
				        "Year Month Number", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				        "Month Year", FORMAT ( [Date], "MMM yyyy", "en-US" ),
				        "Day Type", IF ( WEEKDAY ( [Date], 2 ) > 5, "Weekend", "Weekday" )
				    )

	annotation PBI_Id = 3f447249b5e44f0189413048866627ae

